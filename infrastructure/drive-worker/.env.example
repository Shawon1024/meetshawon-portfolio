# Worker identity and timing
WORKER_NAME=meetshawon-nas-worker-01
POLL_INTERVAL_MS=30000
DRY_RUN=true

# Supabase provisioning queue
SUPABASE_FUNCTION_URL=https://itxvbmcmcurlhsztatud.supabase.co/functions/v1/drive-provisioning
DRIVE_WORKER_SECRET=replace-with-supabase-worker-secret

# TrueNAS JSON-RPC WebSocket API
TRUENAS_WS_URL=wss://192.168.1.250/api/current
TRUENAS_API_KEY=replace-with-truenas-api-key
TRUENAS_REJECT_UNAUTHORIZED=false
TRUENAS_PARENT_DATASET=NAS_STORAGE_01/partner_dataset
TRUENAS_PARENT_MOUNT=/mnt/NAS_STORAGE_01/partner_dataset
TRUENAS_NEXTCLOUD_UID=33
DRIVE_QUOTA_BYTES=108447924224

# Nextcloud provisioning API
NEXTCLOUD_URL=https://files.meetshawon.com
NEXTCLOUD_WORKER_USERNAME=drive_worker
NEXTCLOUD_WORKER_APP_PASSWORD=replace-with-nextcloud-app-password
NEXTCLOUD_PARTNER_GROUP=partner

# Account notification email
RESEND_API_KEY=replace-with-resend-api-key
DRIVE_EMAIL_FROM=Meet Shawon Drive <no-reply@meetshawon.com>
DRIVE_PORTAL_URL=https://drive.meetshawon.com